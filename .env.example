# RSVX Status settings. This file is a template and IS on GitHub: never put real keys in it.
# On the VPS run: cp .env.example .env   then put the keys in .env (which git ignores).

# Port the status page listens on, and the password to open it.
PORT=8787
STATUS_PASSWORD=

# GitHub: fine-grained token, all repositories, read-only on Metadata, Contents and Actions.
GITHUB_TOKEN=

# Render: Account Settings > API Keys.
RENDER_API_KEY=

# Discord webhook for the live status message and the alerts.
DISCORD_WEBHOOK_URL=
# Optional: who to ping on a failure, e.g. <@123456789012345678>
DISCORD_MENTION=

# Websites to check (response + SSL expiry). Name|URL, comma separated.
SITES=Helm|https://helmpanel.co.uk,ROSTR|https://rostrapp.co.uk,RSVX|https://rsvx.co.uk

# What to watch on this server.
# Linux: systemd units, e.g. nginx,mariadb
WATCH_SYSTEMD=
# Windows: service names, e.g. MariaDB,W3SVC
WATCH_SERVICES=
WATCH_PORTS=FiveM:30120,txAdmin:40120
WATCH_PM2=auto
WATCH_DOCKER=auto
# Folders searched for git repos to compare against GitHub.
# Windows example: REPO_ROOTS=C:\FXServer,C:\Users\Administrator\Documents
REPO_ROOTS=/home,/opt,/srv,/var/www,/root

# Optional: name shown for this server (defaults to the computer name).
VPS_NAME=
# Optional: which areas send Discord alerts. On a second server use vps,sites
# so GitHub and Render failures are not announced twice.
ALERT_GROUPS=vps,render,github,sites

# Optional: a dead-man's-switch URL pinged every minute. If the VPS itself dies,
# that outside service notices the pings stopped and tells you.
HEARTBEAT_URL=

# Optional: names to leave out, comma separated.
IGNORE_REPOS=
IGNORE_SERVICES=
